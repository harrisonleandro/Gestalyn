<Project>

  <!-- Configuração compartilhada por todos os projetos da solução. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Identidade e versão. A versão é a única fonte usada por API, Web e CLI. -->
  <PropertyGroup>
    <Product>ProjectManager</Product>
    <Company>RiukDev</Company>
    <Copyright>Copyright © RiukDev</Copyright>
    <VersionPrefix>0.1.0</VersionPrefix>
    <NeutralLanguage>pt-BR</NeutralLanguage>
  </PropertyGroup>

  <!-- Qualidade de código: analisadores habilitados e avisos tratados como erros. -->
  <PropertyGroup>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Builds reprodutíveis no GitHub Actions. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Projetos de teste: não empacotáveis. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

</Project>
