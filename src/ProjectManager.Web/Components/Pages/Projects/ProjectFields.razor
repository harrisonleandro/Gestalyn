@* Campos do projeto, usados na criação e na edição. *@
<div class="pm-form-grid">
    <div>
        <label for="project-name" class="form-label">Nome</label>
        <InputText id="project-name" class="form-control" @bind-Value="Model.Name" name="@(Prefix + ".Name")" />
        <ValidationMessage For="() => Model.Name" />
    </div>
    <div>
        <label for="project-priority" class="form-label">Prioridade</label>
        <InputSelect id="project-priority" class="form-select" @bind-Value="Model.Priority" name="@(Prefix + ".Priority")">
            @foreach (var priority in Enum.GetValues<Priority>())
            {
                <option value="@priority">@Display.Name(priority)</option>
            }
        </InputSelect>
    </div>
    <div>
        <label for="project-start" class="form-label">Início</label>
        <InputDate id="project-start" class="form-control" @bind-Value="Model.StartDate" name="@(Prefix + ".StartDate")" />
    </div>
    <div>
        <label for="project-due" class="form-label">Prazo</label>
        <InputDate id="project-due" class="form-control" @bind-Value="Model.DueDate" name="@(Prefix + ".DueDate")" />
    </div>
</div>
<div class="mt-3">
    <label for="project-tags" class="form-label">Etiquetas</label>
    <InputText id="project-tags" class="form-control" @bind-Value="Model.Tags" name="@(Prefix + ".Tags")" aria-describedby="project-tags-help" />
    <div id="project-tags-help" class="form-text">Separe com vírgulas.</div>
</div>
<div class="mt-3">
    <label for="project-description" class="form-label">Descrição</label>
    <InputTextArea id="project-description" class="form-control" rows="4" @bind-Value="Model.Description" name="@(Prefix + ".Description")" />
    <ValidationMessage For="() => Model.Description" />
</div>

@code {
    /// <summary>Nome da propriedade do formulário na página (ex.: Input): os campos postam como Prefixo.Campo.</summary>
    [Parameter, EditorRequired]
    public string Prefix { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public ProjectForm Model { get; set; } = default!;
}
