@page "/o/{OrganizationId:guid}/agentes"
@attribute [Authorize]
@inherits OrganizationPage
@inject AgentsApi Agents

<PageTitle>Agentes · Gestalyn</PageTitle>

<OrgFrame Membership="Membership" Error="LoadError" Ready="_agents is not null">
    <PageHeader Title="Agentes" Subtitle="Integrações que acessam projetos com credenciais próprias, permissões limitadas e auditoria." />
    <ApiErrors Result="ActionResult" />

    <div class="pm-card">
        @if (_agents!.Count == 0)
        {
            <EmptyState Title="Nenhum agente" Message="Crie um agente para conectar uma integração ou um assistente aos projetos da organização." />
        }
        else
        {
            <table class="table pm-table align-middle">
                <thead><tr><th scope="col">Nome</th><th scope="col">Situação</th><th scope="col">Credenciais ativas</th><th scope="col">Projetos</th><th scope="col">Criado em</th></tr></thead>
                <tbody>
                    @foreach (var agent in _agents)
                    {
                        <tr>
                            <td data-label="Nome">
                                <a href="@($"{OrgPath}/agentes/{agent.Id}")">@agent.Name</a>
                                @if (agent.Description is not null)
                                {
                                    <span class="pm-muted small d-block">@agent.Description</span>
                                }
                            </td>
                            <td data-label="Situação"><span class="pm-label">@Display.Name(agent.Status)</span></td>
                            <td data-label="Credenciais ativas">@agent.ActiveCredentials</td>
                            <td data-label="Projetos">@agent.Projects</td>
                            <td data-label="Criado em">@Display.Date(agent.CreatedAt)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="pm-card">
        <h2>Novo agente</h2>
        <EditForm Model="Create" FormName="create-agent" OnValidSubmit="CreateAsync" Enhance class="pm-form-grid">
            <DataAnnotationsValidator />
            <div>
                <label for="agent-name" class="form-label">Nome</label>
                <InputText id="agent-name" class="form-control" @bind-Value="Create.Name" maxlength="100" />
                <ValidationMessage For="() => Create.Name" />
            </div>
            <div>
                <label for="agent-description" class="form-label">Descrição (opcional)</label>
                <InputText id="agent-description" class="form-control" @bind-Value="Create.Description" maxlength="500" />
                <ValidationMessage For="() => Create.Description" />
            </div>
            <div class="d-flex align-items-end"><button type="submit" class="btn btn-primary">Criar agente</button></div>
        </EditForm>
        <p class="pm-muted small mt-2 mb-0">O agente começa sem credenciais e sem acesso a projetos. Agentes nunca aprovam tarefas nem as concluem.</p>
    </div>
</OrgFrame>

@code {
    [SupplyParameterFromForm(FormName = "create-agent")]
    private AgentForm Create { get; set; } = default!;

    private List<AgentSummary>? _agents;

    protected override void OnInitialized() => Create ??= new AgentForm();

    protected override async Task LoadAsync()
    {
        // A permissão vem da API; sem ela, a tela nem pede a lista (a API também recusaria com 403).
        if (!Membership!.Can(Permissions.AgentsManage))
        {
            Fail(ApiResult.Failure(System.Net.HttpStatusCode.Forbidden, "Gerenciar agentes exige a permissão agents.manage."));
            return;
        }

        _agents = Take(await Agents.ListAsync(OrganizationId));
    }

    private async Task CreateAsync()
    {
        var response = await Agents.CreateAsync(OrganizationId, Create.Name, string.IsNullOrWhiteSpace(Create.Description) ? null : Create.Description);
        Complete(response, "agente-criado", response.Value is { } agent ? $"{OrgPath}/agentes/{agent.Id}" : null);
    }
}
