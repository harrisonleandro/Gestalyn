@page "/conta/redefinir-senha"
@inject ApiAccountClient Api

<PageTitle>Redefinir senha · Gestalyn</PageTitle>

<div class="account-card pm-card">
    <h1 class="h3 mb-4">Nova senha</h1>

    @if (string.IsNullOrEmpty(Email) || string.IsNullOrEmpty(Token))
    {
        <div class="alert alert-danger" role="alert">Link de redefinição incompleto.</div>
        <a href="conta/esqueci-a-senha">Solicitar um novo link</a>
    }
    else if (_result is { Succeeded: true })
    {
        <div class="alert alert-success" role="status">
            Senha redefinida. Por segurança, todas as sessões abertas foram encerradas.
        </div>
        <a href="conta/entrar" class="btn btn-primary w-100">Entrar</a>
    }
    else
    {
        <p class="pm-muted">Conta: @Email</p>
        <ApiErrors Result="_result" />

        <EditForm Model="Input" FormName="reset-password" OnValidSubmit="SubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />

            <div class="mb-3">
                <label for="password" class="form-label">Nova senha</label>
                <InputText id="password" type="password" class="form-control" autocomplete="new-password" @bind-Value="Input.Password" />
                <div class="form-text">Mínimo de 12 caracteres.</div>
            </div>
            <div class="mb-4">
                <label for="confirmPassword" class="form-label">Confirme a nova senha</label>
                <InputText id="confirmPassword" type="password" class="form-control" autocomplete="new-password" @bind-Value="Input.ConfirmPassword" />
            </div>
            <button type="submit" class="btn btn-primary w-100">Redefinir senha</button>
        </EditForm>
    }
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? Token { get; set; }

    [SupplyParameterFromForm]
    private NewPasswordForm Input { get; set; } = default!;

    private ApiResult? _result;

    protected override void OnInitialized() => Input ??= new NewPasswordForm();

    private async Task SubmitAsync()
    {
        _result = await Api.ResetPasswordAsync(Email!, Token!, Input.Password, HttpContext.RequestAborted);
        Input.Password = string.Empty;
        Input.ConfirmPassword = string.Empty;
    }
}
