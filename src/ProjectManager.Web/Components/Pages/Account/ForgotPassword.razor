@page "/conta/esqueci-a-senha"
@inject ApiAccountClient Api

<PageTitle>Esqueci a senha · Gestalyn</PageTitle>

<div class="account-card pm-card">
    <h1 class="h3 mb-4">Esqueci a senha</h1>

    @if (_result is { Succeeded: true })
    {
        <div class="alert alert-success" role="status">
            Se houver uma conta com este e-mail, enviamos um link para redefinir a senha. O link expira em 2 horas.
        </div>
    }
    else
    {
        <p class="pm-muted">Informe o e-mail da conta. Enviaremos um link para você escolher uma nova senha.</p>
        <ApiErrors Result="_result" />

        <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="SubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />

            <div class="mb-4">
                <label for="email" class="form-label">E-mail</label>
                <InputText id="email" type="email" class="form-control" autocomplete="email" @bind-Value="Input.Email" />
            </div>
            <button type="submit" class="btn btn-primary w-100">Enviar link</button>
        </EditForm>
    }

    <p class="mt-4 mb-0"><a href="conta/entrar">Voltar para o login</a></p>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private EmailForm Input { get; set; } = default!;

    private ApiResult? _result;

    protected override void OnInitialized() => Input ??= new EmailForm();

    private async Task SubmitAsync() =>
        _result = await Api.ForgotPasswordAsync(Input.Email, HttpContext.RequestAborted);
}
