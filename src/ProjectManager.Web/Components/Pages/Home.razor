@page "/"
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Gestalyn</PageTitle>

<AuthorizeView>
    <NotAuthorized>
        <div class="pm-card account-card text-center">
            <h1 class="mb-2">Gestalyn</h1>
            <p class="pm-muted">
                Projetos, equipes, tarefas, documentação e atividades, com pessoas e agentes de IA trabalhando juntos.
            </p>
            <div class="d-flex gap-2 justify-content-center mt-3">
                <a href="conta/entrar" class="btn btn-primary">Entrar</a>
                <a href="conta/cadastro" class="btn btn-outline-secondary">Criar conta</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is null || (await AuthenticationState).User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        // Volta para a última organização aberta (D3); a página da organização confirma a associação na API.
        var last = HttpContextAccessor.HttpContext?.Request.Cookies[WebEndpoints.LastOrganizationCookie];
        Navigation.NavigateTo(Guid.TryParse(last, out var organizationId) ? $"/o/{organizationId}" : "/organizacoes");
    }
}
