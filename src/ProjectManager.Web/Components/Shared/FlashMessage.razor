@* Aviso de sucesso depois do redirecionamento. Só mensagens conhecidas (Flash.MessageFor). *@
@inject NavigationManager Navigation

@if (_message is not null)
{
    <div class="alert alert-success pm-flash" role="status">
        <Icon Name="check" /> @_message
    </div>
}

@code {
    private string? _message;

    protected override void OnParametersSet()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        _message = query.TryGetValue(Flash.QueryName, out var key) ? Flash.MessageFor(key.ToString()) : null;
    }
}
